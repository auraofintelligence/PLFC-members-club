{
  "name": "plfc-clubhouse",
  "main": "dist/server/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "ai": {"binding":"AI"},
  "triggers": {"crons":["*/5 * * * *"]},
  "durable_objects": {"bindings":[{"name":"OFFICER_DEMOS","class_name":"OfficerDemoRoom"}]},
  "migrations": [{"tag":"officer-demo-v1","new_sqlite_classes":["OfficerDemoRoom"]}],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "plfc-clubhouse",
    "database_id": "5fbb019c-8268-4c1f-98f7-06d7858b7599",
    "migrations_dir": "drizzle"
  },{
    "binding": "SHOWCASE_DB",
    "database_name": "plfc-clubhouse-showcase",
    "database_id": "38f916c7-4222-4d9d-a650-e9d1f5d6100b"
  }],
  "previews": {
    "vars": {"ENVIRONMENT": "preview", "OUTBOUND_ENABLED": "false", "SMS_ENABLED": "false"},
    "ai": {"binding": "AI"},
    "durable_objects": {"bindings": [{"name":"OFFICER_DEMOS","class_name":"OfficerDemoRoom"}]}
  },
  "build": { "command": "node scripts/build.mjs" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/constitution.pdf", "/calendar.ics", "/calendar/*"]
  }
}
